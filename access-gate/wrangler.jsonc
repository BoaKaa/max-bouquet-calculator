{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sales-diagnostic-vk-donut",
  "compatibility_date": "2026-10-13",
  "main": "src/worker.mjs",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
